generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model InvestigationCache {
  id             String   @id @default(cuid())
  subjectHash    String   @unique
  subjectData    String   // JSON string of Subject
  resultData     String   // JSON string of InvestigationResult
  confidence     Int
  durationMs     Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
